{
  "name": "@auction/test-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global-setup": {
      "types": "./dist/global-setup.d.ts",
      "default": "./dist/global-setup.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "echo 'test-kit is exercised by the packages that use it'"
  },
  "dependencies": {
    "@auction/db": "workspace:*",
    "@auction/shared": "workspace:*",
    "pg": "^8.23.1",
    "vitest": "^5.1.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
