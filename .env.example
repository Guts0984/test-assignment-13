# =============================================================================
# Auction — environment
#
#   cp .env.example .env && docker compose up --build
#
# Values marked DEV-ONLY are placeholders that make the local stack work out of
# the box. They are NOT secrets; replace every one of them outside development.
# Each process validates this file with Zod (apps/*/src/env.ts): non-sensitive
# settings have defaults there, secrets have none and must be set.
# =============================================================================

# --- general -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TZ=UTC

# --- auction rules: timings (ms) ----------------------------------------------
# Defaults are the assignment's values; tests override them to compress time.
ANTI_SNIPE_MS=120000            # bid in the last 2 min moves the end to now + 2 min
PAYMENT_WINDOW_MS=172800000     # winner pays within 48 h
OFFER_WINDOW_MS=86400000        # second-chance offer lives 24 h
REVIEW_CLAIM_MS=900000          # moderator claim expires after 15 min
AUTO_CONFIRM_MS=604800000       # receipt auto-confirmed 7 days after shipping
OUTBID_EMAIL_THROTTLE_MS=900000 # at most one "outbid" email per lot per 15 min
FAVORITE_REMINDER_MS=3600000    # favourite reminder 1 h before the end

# --- postgres ----------------------------------------------------------------
# DEV-ONLY passwords. POSTGRES_USER owns the schema and runs migrations + seed (db-init);
# the API and worker connect as APP_DB_USER, which cannot disable triggers, drop constraints
# or truncate tables (see packages/db/src/roles.ts).
POSTGRES_USER=auction
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=auction
DATABASE_ADMIN_URL=postgres://auction:dev-only-postgres-password@postgres:5432/auction
APP_DB_USER=auction_app
APP_DB_PASSWORD=dev-only-app-db-password
# What the API and worker use (restricted role):
DATABASE_URL=postgres://auction_app:dev-only-app-db-password@postgres:5432/auction

# --- seed (demo data; every user has the password below) ---------------------
SEED_ENABLED=true
SEED_USERS=10000
SEED_LOTS=50000
SEED_BIDS=500000
SEED_RNG=13
SEED_PASSWORD=Passw0rd!
