# =============================================================================
# Auction — environment
#
#   cp .env.example .env && docker compose up --build
#
# Values marked DEV-ONLY are placeholders that make the local stack work out of
# the box. They are NOT secrets; replace every one of them outside development.
# Each process validates this file with Zod (apps/*/src/env.ts): non-sensitive
# settings have defaults there, secrets have none and must be set.
# =============================================================================

# --- general -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TZ=UTC

# --- auction rules: timings (ms) ----------------------------------------------
# Defaults are the assignment's values; tests override them to compress time.
ANTI_SNIPE_MS=120000            # bid in the last 2 min moves the end to now + 2 min
PAYMENT_WINDOW_MS=172800000     # winner pays within 48 h
OFFER_WINDOW_MS=86400000        # second-chance offer lives 24 h
REVIEW_CLAIM_MS=900000          # moderator claim expires after 15 min
AUTO_CONFIRM_MS=604800000       # receipt auto-confirmed 7 days after shipping
OUTBID_EMAIL_THROTTLE_MS=900000 # at most one "outbid" email per lot per 15 min
FAVORITE_REMINDER_MS=3600000    # favourite reminder 1 h before the end

# --- postgres ----------------------------------------------------------------
# DEV-ONLY passwords. POSTGRES_USER owns the schema and runs migrations + seed (db-init);
# the API and worker connect as APP_DB_USER, which cannot disable triggers, drop constraints
# or truncate tables (see packages/db/src/roles.ts).
POSTGRES_USER=auction
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=auction
DATABASE_ADMIN_URL=postgres://auction:dev-only-postgres-password@postgres:5432/auction
APP_DB_USER=auction_app
APP_DB_PASSWORD=dev-only-app-db-password
# What the API and worker use (restricted role):
DATABASE_URL=postgres://auction_app:dev-only-app-db-password@postgres:5432/auction

# --- seed (demo data; every user has the password below) ---------------------
SEED_ENABLED=true
SEED_USERS=10000
SEED_LOTS=50000
SEED_BIDS=500000
SEED_RNG=13
SEED_PASSWORD=Passw0rd!

# --- redis -------------------------------------------------------------------
# Queues (BullMQ) and socket pub/sub only. Not persistent on purpose: Postgres is the truth.
REDIS_URL=redis://redis:6379

# --- meilisearch (search projection of Postgres) -----------------------------
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=dev-only-meili-master-key-change-me

# --- minio (S3-compatible photo storage) -------------------------------------
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z   # community build; the official image is gone from Docker Hub
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=dev-only-minio-user
S3_SECRET_KEY=dev-only-minio-secret-change-me
S3_PRIVATE_BUCKET=photos-private
S3_PUBLIC_BUCKET=photos-public

# --- mail stub (Mailpit: SMTP in, web page out at http://localhost:8025) -----
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@auction.local

# --- payment stub ------------------------------------------------------------
# HMAC secret for webhooks and the key for the provider's status API (DEV-ONLY values).
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
PAYMENT_PROVIDER_API_KEY=dev-only-provider-api-key-change-me
# true = webhooks come twice, late (up to a minute), out of order (failed after succeeded) or never.
PAYMENT_STUB_CHAOS=false
# Where the worker reaches the API's /provider/* endpoints (status API for the reconciler).
PROVIDER_BASE_URL=http://nginx:8080

# --- worker ------------------------------------------------------------------
SWEEPER_INTERVAL_MS=1000   # how often Postgres is asked what is due (queues jobs, so Redis loss heals)

# --- api ---------------------------------------------------------------------
PUBLIC_URL=http://localhost:8080
# Only these peers may set X-Forwarded-For (the nginx container on the compose network).
TRUSTED_PROXY="loopback, linklocal, uniquelocal"
# true = POST /__test/clock may move the server clock (tests only; the route does not exist otherwise).
TEST_CLOCK=false

# Host port for the whole app (nginx). Change it if 8080 is taken; keep PUBLIC_URL in step.
HTTP_PORT=8080

# --- rate limits (per client address; raise only for acceptance runs) ----------
# RATE_REGISTER_PER_HOUR=20
# RATE_BID_PER_10S=40
# RATE_GLOBAL_PER_MIN=600
# RATE_TOPUP_PER_MIN=10
